// ============================================================================
// 1. DESIGN SYSTEM ORGANIZATION
// ============================================================================

/**
 * The design system is split into 2 files for easy maintenance:
 * 
 * - design-system-colors.ts
 *   └─ All color definitions and semantic color combinations
 *   └─ Color modifier functions (lighten, darken, alpha)
 * 
 * - design-system-tokens.ts
 *   └─ Spacing scale, typography, animations
 *   └─ Border radius, sizes, breakpoints
 *   └─ Style composition helpers
 * 
 * BENEFIT: Changing one value updates the entire app. No scattered hex colors.
 */

// HOW TO MODIFY:
// 1. Change color: colors.ts → colors.primary = '#new-color'
// 2. Change spacing: tokens.ts → spacing.md = '1.25rem'
// 3. Change font size: tokens.ts → typography.h1.fontSize = '2.5rem'
// All components automatically pick up the changes.

// ============================================================================
// 2. COMPONENT ARCHITECTURE
// ============================================================================

/**
 * Components are organized by responsibility:
 * 
 * REUSABLE COMPONENTS (Low-level):
 * - Card: Base container for all panels
 * - StatCard: KPI with icon and value
 * - ProgressBar: Visual progress indicator
 * - Badge: Small label/tag component
 * 
 * COMPOSITE COMPONENTS (High-level):
 * - Header: Welcome greeting
 * - HeroStats: 4-column KPI section
 * - ProgressSection: Learning progress indicators
 * - LabsPanel: Active labs list
 * - SkillsTracker: Skills proficiency grid
 * - MilestonesTimeline: Phase milestones
 * 
 * LAYOUT COMPONENT:
 * - PentestDashboard: Main container, widget orchestration
 */

// ============================================================================
// 3. WIDGET SYSTEM (Extensibility)
// ============================================================================

/**
 * The dashboard uses a widget-based architecture.
 * Each section can be added/removed independently.
 * 
 * Current widgets in PentestDashboard:
 */
const widgetsExample = [
  'hero-stats',      // KPI cards at the top
  'progress',        // Learning progress bars
  'labs',            // Active labs list
  'skills',          // Skills proficiency
  'milestones',      // Phase milestones
];

/**
 * ADDING A NEW WIDGET:
 * 
 * 1. Create component function:
 *    const MyNewWidget: React.FC<{data: any}> = ({data}) => (...)
 * 
 * 2. Add case to renderWidget():
 *    case 'my-widget':
 *      return <MyNewWidget key={widgetId} data={mockData} />
 * 
 * 3. Add to widgets array:
 *    setWidgets([...widgets, 'my-widget'])
 * 
 * 4. Optional: Store widget order in localStorage
 * 
 * Example: Adding a "Recommended Labs" widget
 * ─────────────────────────────────────────
 * const RecommendedLabs: React.FC = () => (
 *   <Card>
 *     <h4>Recommended for You</h4>
 *     {/* Show ML-recommended labs */}
 *   </Card>
 * )
 * 
 * widgets.push('recommended-labs')
 * renderWidget('recommended-labs') → <RecommendedLabs />
 */

// ============================================================================
// 4. DATA STRUCTURE
// ============================================================================

/**
 * Mock data is centralized at the top of pentest-dashboard.tsx
 * In production, this would come from your backend API.
 */

interface DashboardData {
  userName: string;
  currentPhase: number;
  totalPhases: number;
  labsCompleted: number;
  labsTotal: number;
  hoursSpent: number;
  targetHours: number;
  dayStreak: number;
  weeklyGoal: number;
  completedThisWeek: number;
}

interface Lab {
  id: string;
  name: string;
  category: string;
  difficulty: 'Beginner' | 'Intermediate' | 'Advanced';
  status: 'completed' | 'in_progress' | 'locked';
  progress: number;
}

interface Skill {
  id: string;
  name: string;
  category: 'Burp Suite' | 'Methodology' | 'Vulnerability';
  level: 'Beginner' | 'Intermediate' | 'Advanced' | 'Expert';
}

interface Milestone {
  id: string;
  title: string;
  description: string;
  dueDate: string;
  completed: boolean;
  phase: number;
}

/**
 * TO USE REAL DATA:
 * 1. Replace mockDashboardData with API call (useEffect)
 * 2. Replace mockLabs, mockSkills, mockMilestones similarly
 * 3. Add loading/error states
 * 
 * Example:
 * const [data, setData] = useState<DashboardData | null>(null);
 * useEffect(() => {
 *   fetch('/api/dashboard/data')
 *     .then(r => r.json())
 *     .then(setData)
 *     .catch(err => console.error(err));
 * }, []);
 */

