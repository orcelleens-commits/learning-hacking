// 6. COMMON MODIFICATIONS
// ============================================================================

/**
 * CHANGE: Color scheme (Dark mode)
 * ─────────────────────────────
 * Create a second color set in colors.ts:
 * export const colorsDark = { ... }
 * 
 * In PentestDashboard, detect theme:
 * const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
 * const palette = isDark ? colorsDark : colors;
 * 
 * Pass to components:
 * <Card colors={palette} />
 */

/**
 * CHANGE: Add a new dashboard section
 * ───────────────────────────────────
 * 1. Create new component
 * 2. Add widget ID to renderWidget()
 * 3. Push to widgets array
 * 4. The grid will automatically layout
 */

/**
 * CHANGE: Modify grid layout
 * ──────────────────────────
 * Update the grid style in PentestDashboard:
 * Current: gridTemplateColumns: 'repeat(auto-fit, minmax(300px, 1fr))'
 * 
 * For 2 columns:  'repeat(2, 1fr)'
 * For responsive: 'repeat(auto-fit, minmax(250px, 1fr))'
 * For 3 columns:  'repeat(auto-fit, minmax(350px, 1fr))'
 */

/**
 * CHANGE: Adjust spacing
 * ──────────────────────
 * All spacing uses spacing.* constants
 * To increase padding everywhere:
 * spacing.md: '1rem' → '1.25rem'
 * 
 * Only needs one change in design-system-tokens.ts
 */

